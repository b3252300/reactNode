{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "react-node-auth-app",
  "main": "backend/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // 前端 Vite build 產物；/api/* 交給 Worker（Express），其餘路徑以 SPA 方式回傳 index.html。
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  // 非機密設定。機密設定（MONGODB_URI、JWT_ACCESS_SECRET）請用 `npx wrangler secret put` 設定。
  "vars": {
    "NODE_ENV": "production",
    "COOKIE_SAME_SITE": "lax",
    // 部署後請改成實際網址（例如 https://react-node-auth-app.<子網域>.workers.dev），不可有結尾斜線。
    "CLIENT_ORIGIN": "https://react-node-auth-app.house-rental.workers.dev"
  },
  // 取代 express-rate-limit 的記憶體計數；period 只能是 10 或 60 秒。
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "REGISTER_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_SERVER",
        "class_name": "ApiServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ApiServer"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}